# ============================================================
# .env.example — Regime-Aware Trading Framework
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Data Provider ----
# Primary market data source.
# Options: yfinance (free, no key) | alpha_vantage | twelve_data | polygon | csv
MARKET_DATA_PROVIDER=yfinance

# ---- News / Economic Calendar Provider ----
# Options: csv (free, use your own file) | trading_economics
NEWS_DATA_PROVIDER=csv

# ---- API Keys (only required for the matching provider) ----

# Alpha Vantage — free tier: 25 req/day, 5 req/min
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Twelve Data — free tier: 800 req/day
# Get key: https://twelvedata.com/register
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Polygon.io — free tier: forex/crypto/equities, 5 req/min
# Get key: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# Trading Economics — paid, used for economic calendar only
# Get key: https://tradingeconomics.com/settings/api.aspx
TRADING_ECONOMICS_API_KEY=your_trading_economics_key_here
TRADING_ECONOMICS_API_SECRET=your_trading_economics_secret_here

# ---- Storage Paths ----

# Directory for cached Parquet data files
DATA_CACHE_DIR=./data_cache

# Directory for CSV market data files (csv provider fallback)
# Expected file pattern: {SYMBOL}_{TIMEFRAME}.csv or {SYMBOL}.csv
# Example: EURUSD_1h.csv, BTCUSD_1d.csv
MARKET_DATA_CSV_DIR=./data/market

# Path to economic calendar CSV file (news csv provider)
# Expected columns: datetime, currency, impact, event
NEWS_DATA_CSV_PATH=./data/news/events.csv

# ---- Output ----

# Path where the MT5 bridge signal file is written
# Must be accessible by the MT5 EA (e.g. MT5 Files/ directory or shared folder)
MT5_SIGNAL_OUTPUT_PATH=./signals/latest_signal.json

# ---- System ----

# Timezone for session filtering and display
# Use UTC for backtesting and production
TIMEZONE=UTC

# Default risk per trade as % of account equity
DEFAULT_RISK_PCT=0.5
